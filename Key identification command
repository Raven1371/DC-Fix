Get-ChildItem Cert:\LocalMachine\Root |
Where-Object {$_.Subject -like "*CN=rain-DC-CA*"} |
ForEach-Object {
    $ski = $_.Extensions |
        Where-Object {$_.Oid.Value -eq "2.5.29.14"}

    [PSCustomObject]@{
        Subject      = $_.Subject
        Thumbprint   = $_.Thumbprint
        SerialNumber = $_.SerialNumber
        NotBefore    = $_.NotBefore
        NotAfter     = $_.NotAfter
        SubjectKeyID = $ski.Format($false)
    }
}

** --Export Cert via PowerShell-- **

$cert = Get-ChildItem Cert:\LocalMachine\Root |
Where-Object {
    $_.Thumbprint -eq "AD0D88C92C56F8E1656C967ABFB0E1A99F553B47"
} |
Select-Object -First 1

Export-Certificate `
  -Cert $cert `
  -FilePath "C:\Temp\rain-DC-CA.cer" `
  -Type CERT

